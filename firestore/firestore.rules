rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur "eingeloggte" (auch anonym) Nutzer dürfen lesen/schreiben -
    // schützt vor wildfremden Bots im Internet, ohne dass sich Leon/Lotta
    // aktiv irgendwo anmelden müssen.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
